{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign variant_image = variant.featured_media.preview_image | default: product.featured_image
  assign is_bundle = false
  if settings.bundle_tag != blank and product.tags contains settings.bundle_tag
    assign is_bundle = true
  endif
-%}
<section class="pdp" data-product-section data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="crumbs load" aria-label="{{ 'general.breadcrumbs' | t }}" style="--d:.05s">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a>
        {%- endif -%}
        <span aria-hidden="true">/</span><span aria-current="page">{{ product.title | escape }}</span>
      </nav>
    {%- endif -%}
    <div class="pdp__grid">
      <div class="pdp__gallery load" style="--d:.15s">
        <div class="pdp__visual" data-main-media>
          {%- render 'product-media', product: product, image: variant_image, priority: true, sizes: '(min-width: 861px) 45vw, 100vw' -%}
        </div>
        {%- if product.media.size > 1 and is_bundle == false -%}
          <ul class="pdp__thumbs" aria-label="{{ 'products.gallery' | t }}">
            {%- for media in product.media -%}
              <li>
                <button type="button" data-thumb data-media-id="{{ media.id }}" aria-label="{{ 'products.show_image' | t: number: forloop.index }}"{% if media.preview_image.src == variant_image.src %} aria-current="true"{% endif %}>
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', class: 'shot' }}
                </button>
                <template data-media-template="{{ media.id }}">{% render 'shot', image: media.preview_image, alt: product.title, sizes: '(min-width: 861px) 45vw, 100vw' %}</template>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="pdp__info">
        {%- for block in section.blocks -%}
          {%- assign delay = forloop.index | times: 0.08 | plus: 0.12 -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'tagline' -%}
              {%- assign tagline = product.metafields.custom.tagline.value -%}
              {%- if tagline != blank %}<p class="eyebrow load" style="--d:{{ delay }}s" {{ block.shopify_attributes }}>{{ tagline }}</p>{% endif %}

            {%- when 'title' -%}
              <h1 class="pdp__name load" style="--d:{{ delay }}s" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'rating' -%}
              <div class="load" style="--d:{{ delay }}s" {{ block.shopify_attributes }}>
                {%- if variant.compare_at_price > variant.price -%}
                  {%- assign saving = variant.compare_at_price | minus: variant.price | money -%}
                  <p class="product__rating"><span class="pcard__badge" data-saving>{{ 'products.save_amount' | t: amount: saving }}</span></p>
                {%- endif -%}
                {%- render 'stars', product: product -%}
              </div>

            {%- when 'price' -%}
              <div class="load" style="--d:{{ delay }}s" {{ block.shopify_attributes }}>
                <p class="pdp__price"><span data-price>{% render 'price', product: product, variant: variant %}</span> <span data-size{% if product.metafields.custom.size != blank %} data-from-metafield="true"{% endif %}>{% render 'product-size', product: product, variant: variant %}</span></p>
                <p class="pdp__tax"><span data-unit-price>{% render 'unit-price', variant: variant %}</span> {% render 'tax-note' %}</p>
              </div>

            {%- when 'text' -%}
              {%- assign summary = product.metafields.custom.short_description.value -%}
              {%- if summary == blank and block.settings.fallback_to_description -%}
                {%- assign summary = product.description | strip_html | truncatewords: 40 -%}
              {%- endif -%}
              {%- if summary != blank %}<p class="pdp__text load" style="--d:{{ delay }}s" {{ block.shopify_attributes }}>{{ summary }}</p>{% endif %}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker load" style="--d:{{ delay }}s" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker__option">
                      <legend class="pcard__meta">{{ option.name | escape }}</legend>
                      <div class="chips">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                          <input type="radio" id="{{ input_id }}" name="{{ section.id }}-option-{{ option.position }}" value="{{ value | escape }}" data-option-position="{{ option.position }}"{% if option.selected_value == value %} checked{% endif %}>
                          <label class="chip" for="{{ input_id }}">{{ value | escape }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json" data-variants>
                    {%- capture variants_json -%}[{%- for v in product.variants -%}{"id":{{ v.id }},"available":{{ v.available | json }},"options":{{ v.options | json }},"price":{{ v.price | money | json }},"compare":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},"saving":{% if v.compare_at_price > v.price %}{% assign s = v.compare_at_price | minus: v.price | money %}{{ 'products.save_amount' | t: amount: s | json }}{% else %}null{% endif %},"unit":{% capture u %}{% render 'unit-price', variant: v %}{% endcapture %}{{ u | strip | json }},"size":{{ v.title | json }},"media":{{ v.featured_media.id | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
                    {{ variants_json }}
                  </script>
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="load" style="--d:{{ delay }}s" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'pdp__buy', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>
                <span class="qty" role="group" aria-label="{{ 'cart.quantity' | t }}">
                  <button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">−</button>
                  <input type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" aria-label="{{ 'cart.quantity' | t }}" data-qty-input>
                  <button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">+</button>
                </span>
                <button class="btn btn--bronze" type="submit" name="add" data-add-button{% unless variant.available %} disabled{% endunless %}>
                  <span data-add-label>{% if variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span> <svg aria-hidden="true"><use href="#i-arrow"/></svg>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="pdp__dynamic">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}
              </div>

            {%- when 'badges' -%}
              <ul class="pdp__badges load" style="--d:{{ delay }}s" {{ block.shopify_attributes }}>
                {%- if block.settings.badge_1 != blank %}<li><svg aria-hidden="true"><use href="#i-leaf"/></svg>{{ block.settings.badge_1 | escape }}</li>{% endif -%}
                {%- if block.settings.badge_2 != blank %}<li><svg aria-hidden="true"><use href="#i-flask"/></svg>{{ block.settings.badge_2 | escape }}</li>{% endif -%}
                {%- if block.settings.badge_3 != blank %}<li><svg aria-hidden="true"><use href="#i-lotus"/></svg>{{ block.settings.badge_3 | escape }}</li>{% endif -%}
                {%- if block.settings.badge_4 != blank %}<li><svg aria-hidden="true"><use href="#i-shield"/></svg>{{ block.settings.badge_4 | escape }}</li>{% endif -%}
              </ul>

            {%- when 'collapsible_tab' -%}
              {%- liquid
                case block.settings.source
                  when 'description'
                    assign tab_content = product.description
                  when 'how_to_use'
                    assign tab_content = product.metafields.custom.how_to_use | metafield_tag
                  when 'key_ingredients'
                    assign tab_content = product.metafields.custom.key_ingredients | metafield_tag
                  else
                    assign tab_content = block.settings.content
                endcase
                if block.settings.source == 'how_to_use' and product.metafields.custom.how_to_use == blank
                  assign tab_content = ''
                endif
                if block.settings.source == 'key_ingredients' and product.metafields.custom.key_ingredients == blank
                  assign tab_content = ''
                endif
              -%}
              {%- if tab_content != blank -%}
                <div class="accordion load" style="--d:{{ delay }}s" {{ block.shopify_attributes }}>
                  <details{% if block.settings.open %} open{% endif %}>
                    <summary>{{ block.settings.heading | escape }}</summary>
                    <div class="accordion__content">
                      {{ tab_content }}
                      {%- if block.settings.link_label != blank and block.settings.link != blank %}<p><a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a></p>{% endif -%}
                    </div>
                  </details>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if product.metafields.reviews.rating.value != blank -%}
  {%- assign rating = product.metafields.reviews.rating.value -%}
{%- endif -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image %}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
    "description": {{ product.description | strip_html | json }},
    {%- if product.vendor != blank %}"brand": { "@type": "Brand", "name": {{ product.vendor | json }} },{% endif %}
    {%- if rating %}"aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ rating.rating | json }}, "bestRating": {{ rating.scale_max | json }}, "reviewCount": {{ product.metafields.reviews.rating_count.value | default: 1 | json }} },{% endif %}
    "offers": [
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
          "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ v.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: v.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "tagline", "name": "Tagline", "limit": 1, "settings": [ { "type": "paragraph", "content": "Shows the product metafield custom.tagline, e.g. \"Strengthen · Nourish · Balance\"." } ] },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating & savings", "limit": 1, "settings": [ { "type": "paragraph", "content": "Stars come from a review app (metafields reviews.rating and reviews.rating_count). The saving badge appears when a compare-at price is set." } ] },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "text", "name": "Short description", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Shows the product metafield custom.short_description." },
      { "type": "checkbox", "id": "fallback_to_description", "label": "Use the start of the description when the metafield is empty", "default": false } ] },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "buy_buttons", "name": "Quantity & add to bag", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout buttons", "default": false, "info": "Shop Pay, PayPal, Apple Pay … directly on the product page." } ] },
    { "type": "badges", "name": "Badges", "limit": 1, "settings": [
      { "type": "text", "id": "badge_1", "label": "Leaf badge", "default": "100% natural ingredients" },
      { "type": "text", "id": "badge_2", "label": "Flask badge", "default": "Silicone free" },
      { "type": "text", "id": "badge_3", "label": "Lotus badge", "default": "Vegan" },
      { "type": "text", "id": "badge_4", "label": "Shield badge", "default": "Dermatologically tested" } ] },
    { "type": "collapsible_tab", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Description" },
      { "type": "select", "id": "source", "label": "Content", "default": "description", "options": [
        { "value": "description", "label": "Product description" },
        { "value": "how_to_use", "label": "Metafield custom.how_to_use" },
        { "value": "key_ingredients", "label": "Metafield custom.key_ingredients" },
        { "value": "custom", "label": "Text below" } ] },
      { "type": "richtext", "id": "content", "label": "Text" },
      { "type": "text", "id": "link_label", "label": "Link label" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false } ] }
  ]
}
{% endschema %}
