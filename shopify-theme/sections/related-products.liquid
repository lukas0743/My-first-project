{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign shown = 0
-%}
<section class="section">
  <div class="container">
    <div class="section__head reveal">
      {%- if section.settings.eyebrow != blank %}<p class="eyebrow eyebrow--line">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {%- if section.settings.heading != blank %}<h2 class="section__title">{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    <div class="shop-grid shop-grid--two">
      {%- for item in source.products -%}
        {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.count -%}{%- break -%}{%- endif -%}
        {%- assign delay = shown | times: 0.1 -%}
        {%- render 'product-card', product: item, delay: delay, heading_tag: 'h3' -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "You may also like",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Complete the Ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "collection", "id": "collection", "label": "Products from", "info": "Leave empty to use all products. The product being viewed is skipped." },
    { "type": "range", "id": "count", "label": "Number of products", "min": 2, "max": 4, "step": 1, "default": 2 }
  ]
}
{% endschema %}
