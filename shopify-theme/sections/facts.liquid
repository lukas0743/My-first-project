<section class="section">
  <div class="container">
    <div class="section__head section__head--center reveal">
      {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {%- if section.settings.heading != blank %}<h2 class="section__title">{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    <dl class="facts reveal">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}><dt>{{ block.settings.value | escape }}</dt><dd>{{ block.settings.label | escape }}</dd></div>
      {%- endfor -%}
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "Key figures",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "What we leave out" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just as important" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Key figure",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "0" },
        { "type": "text", "id": "label", "label": "Label", "default": "Silicones" }
      ]
    }
  ],
  "presets": [ { "name": "Key figures", "blocks": [ { "type": "fact" }, { "type": "fact" } ] } ]
}
{% endschema %}
