<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      {% render 'logo' %}
      {%- if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    </div>
    {%- for block in section.blocks -%}
      {%- if block.settings.menu.links != blank -%}
        <nav aria-label="{{ block.settings.heading | default: block.settings.menu.title | escape }}" {{ block.shopify_attributes }}>
          <h5>{{ block.settings.heading | default: block.settings.menu.title | escape }}</h5>
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        </nav>
      {%- else -%}
        <nav {{ block.shopify_attributes }}></nav>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="container footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name | escape }}</span>
    <span class="footer__legal">
      {%- for policy in shop.policies -%}
        <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
      {%- endfor -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "text", "label": "Text under the logo", "default": "Premium natural haircare for stronger, healthier hair." },
    { "type": "text", "id": "copyright", "label": "Copyright name", "default": "AZULA Natural Care" },
    { "type": "paragraph", "content": "The legal links (privacy, terms, imprint …) come from Settings > Policies." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
