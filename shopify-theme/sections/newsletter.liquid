<section class="newsletter">
  <div class="container newsletter__inner reveal">
    <svg class="newsletter__mark" aria-hidden="true"><use href="#logo-mark"/></svg>
    {%- if section.settings.heading != blank %}<h2 class="statement__title statement__title--sm">{{ section.settings.heading | escape }}</h2>{% endif %}
    {%- if section.settings.text != blank %}<p class="band__text">{{ section.settings.text | escape }}</p>{% endif %}
    {%- assign form_id = 'newsletter-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="{{ form_id }}-email">{{ 'newsletter.email' | t }}</label>
      <input type="email" id="{{ form_id }}-email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
      <button class="btn btn--bronze" type="submit">{{ section.settings.button | default: 'Subscribe' | escape }}</button>
      {%- comment -%} Shopify reloads the page after sending the form; the result is shown below. {%- endcomment -%}
      {%- comment -%} The message line always exists (empty until the form is sent), exactly like the original layout. {%- endcomment -%}
      {%- capture newsletter_message -%}
        {%- if form.posted_successfully? -%}
          <p class="newsletter__msg" role="status">{{ 'newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="newsletter__msg is-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- else -%}
          <p class="newsletter__msg" role="status"></p>
        {%- endif -%}
      {%- endcapture -%}
    {%- endform -%}
    {{ newsletter_message }}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the world of AZULA" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Care rituals, new arrivals and private offers – a few times a year." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Subscribe" },
    { "type": "paragraph", "content": "Sign-ups appear as customers with the tag \"newsletter\" (Customers in Shopify Admin)." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
