<section class="page-hero page-hero--sm">
  <div class="container">
    <p class="eyebrow load" style="--d:.1s">{{ 'customer.eyebrow' | t }}</p>
    <h1 class="page-hero__title load" style="--d:.2s">{{ 'customer.order.title' | t: name: order.name }}</h1>
  </div>
</section>
<section class="section section--flush">
  <div class="container account">
    <div class="account__orders">
      <p class="band__text">{{ order.created_at | time_tag: format: 'date_at_time' }}{% if order.cancelled %} · {{ 'customer.order.cancelled' | t }}{% endif %}</p>
      <table class="table">
        <thead><tr><th scope="col">{{ 'customer.order.product' | t }}</th><th scope="col">{{ 'customer.order.price' | t }}</th><th scope="col">{{ 'cart.quantity' | t }}</th><th scope="col">{{ 'customer.order.total' | t }}</th></tr></thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td><a href="{{ line_item.product.url }}">{{ line_item.title | escape }}</a>{% if line_item.fulfillment %}{% assign fulfilled_date = line_item.fulfillment.created_at | date: format: 'date' %}<br><small>{{ 'customer.order.fulfilled_on' | t: date: fulfilled_date }}</small>{% endif %}</td>
              <td>{{ line_item.final_price | money }}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="3">{{ 'cart.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for discount in order.cart_level_discount_applications -%}
            <tr><td colspan="3">{{ discount.title | escape }}</td><td>−{{ discount.total_allocated_amount | money }}</td></tr>
          {%- endfor -%}
          {%- for shipping_method in order.shipping_methods -%}
            <tr><td colspan="3">{{ shipping_method.title | escape }}</td><td>{{ shipping_method.price | money }}</td></tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr><td colspan="3">{{ tax_line.title | escape }} ({{ tax_line.rate_percentage }}%)</td><td>{{ tax_line.price | money }}</td></tr>
          {%- endfor -%}
          <tr class="table__total"><td colspan="3">{{ 'cart.total' | t }}</td><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
        </tfoot>
      </table>
    </div>
    <aside class="bag__summary">
      <p class="eyebrow">{{ 'customer.order.billing' | t }}</p>
      {{ order.billing_address | format_address }}
      {%- if order.shipping_address -%}
        <p class="eyebrow">{{ 'customer.order.shipping' | t }}</p>
        {{ order.shipping_address | format_address }}
      {%- endif -%}
      <a class="link-arrow" href="{{ routes.account_url }}"><svg class="pagination__prev" aria-hidden="true"><use href="#i-arrow"/></svg> {{ 'customer.account.back' | t }}</a>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Customer order",
  "tag": "div",
  "settings": []
}
{% endschema %}
