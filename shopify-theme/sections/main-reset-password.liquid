<section class="page-hero page-hero--sm">
  <div class="container">
    <p class="eyebrow load" style="--d:.1s">{{ 'customer.eyebrow' | t }}</p>
    <h1 class="page-hero__title load" style="--d:.2s">{{ 'customer.reset.title' | t }}</h1>
  </div>
</section>
<section class="section section--flush">
  <div class="container">
    {%- form 'reset_customer_password', class: 'auth' -%}
      <p class="auth__alt">{{ 'customer.reset.text' | t }}</p>
      {%- if form.errors %}<div class="auth__msg is-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <label for="ResetPassword">{{ 'customer.password' | t }}</label>
      <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      <label for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label>
      <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      <button class="btn btn--bronze" type="submit">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "tag": "div",
  "settings": []
}
{% endschema %}
