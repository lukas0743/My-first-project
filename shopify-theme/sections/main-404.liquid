<section class="page-hero">
  <div class="container">
    <p class="eyebrow load" style="--d:.1s">404</p>
    <h1 class="page-hero__title load" style="--d:.2s">{{ 'general.not_found.title' | t }} <em>{{ 'general.not_found.accent' | t }}</em></h1>
    <p class="page-hero__lead load" style="--d:.35s">{{ 'general.not_found.text' | t }}</p>
    <p class="load page-hero__actions" style="--d:.5s"><a class="btn btn--bronze" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop_collection' | t }} <svg aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
  </div>
</section>

{% schema %}
{
  "name": "Page not found",
  "tag": "div",
  "settings": []
}
{% endschema %}
