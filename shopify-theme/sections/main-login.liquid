<section class="page-hero page-hero--sm">
  <div class="container">
    <p class="eyebrow load" style="--d:.1s">{{ 'customer.eyebrow' | t }}</p>
    <h1 class="page-hero__title load" style="--d:.2s">{{ 'customer.login.title' | t }} <em>{{ 'customer.login.accent' | t }}</em></h1>
  </div>
</section>
<section class="section section--flush">
  <div class="container">
    <div id="login">
      {%- form 'customer_login', class: 'auth', novalidate: 'novalidate' -%}
        {%- if form.errors %}<div class="auth__msg is-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <label for="CustomerEmail">{{ 'customer.email' | t }}</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" autocapitalize="off" required>
        {%- if form.password_needed -%}
          <label for="CustomerPassword">{{ 'customer.password' | t }}</label>
          <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
        {%- endif -%}
        <button class="btn btn--bronze" type="submit">{{ 'customer.login.submit' | t }}</button>
        {%- if form.password_needed %}<p class="auth__alt"><a href="#recover">{{ 'customer.login.forgot' | t }}</a></p>{% endif %}
        <p class="auth__alt">{{ 'customer.login.new' | t }} <a href="{{ routes.account_register_url }}">{{ 'customer.login.create' | t }}</a></p>
      {%- endform -%}
    </div>

    <div id="recover" class="auth-recover">
      {%- form 'recover_customer_password', class: 'auth' -%}
        <h2 class="section__title">{{ 'customer.recover.title' | t }}</h2>
        <p class="auth__alt">{{ 'customer.recover.text' | t }}</p>
        {%- if form.posted_successfully? %}<p class="auth__msg" role="status">{{ 'customer.recover.success' | t }}</p>{% endif %}
        {%- if form.errors %}<div class="auth__msg is-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <label for="RecoverEmail">{{ 'customer.email' | t }}</label>
        <input type="email" id="RecoverEmail" name="email" autocomplete="email" autocapitalize="off" required>
        <button class="btn btn--bronze" type="submit">{{ 'customer.recover.submit' | t }}</button>
        <p class="auth__alt"><a href="#login">{{ 'customer.recover.cancel' | t }}</a></p>
      {%- endform -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      {%- form 'guest_login', class: 'auth auth--guest' -%}
        <button class="btn btn--ghost" type="submit">{{ 'customer.login.guest' | t }}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer login",
  "tag": "div",
  "settings": []
}
{% endschema %}
