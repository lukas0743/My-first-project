<section class="page-hero password">
  <div class="container">
    {% render 'logo' %}
    {%- if section.settings.eyebrow != blank %}<p class="eyebrow load" style="--d:.1s">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 class="page-hero__title load" style="--d:.2s">{{ section.settings.title | escape }} <em>{{ section.settings.title_accent | escape }}</em></h1>
    {%- if shop.password_message != blank %}<p class="page-hero__lead load" style="--d:.35s">{{ shop.password_message }}</p>{% endif %}

    {%- form 'customer', class: 'newsletter__form password__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prospect">
      <label class="sr-only" for="PasswordNewsletter">{{ 'newsletter.email' | t }}</label>
      <input type="email" id="PasswordNewsletter" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
      <button class="btn btn--bronze" type="submit">{{ 'newsletter.notify' | t }}</button>
      {%- capture password_message -%}
        {%- if form.posted_successfully? %}<p class="newsletter__msg" role="status">{{ 'newsletter.success' | t }}</p>{% endif -%}
        {%- if form.errors %}<p class="newsletter__msg is-error" role="alert">{{ form.errors.messages.email }}</p>{% endif -%}
      {%- endcapture -%}
    {%- endform -%}
    {{ password_message }}

    <details class="password__login">
      <summary class="link-arrow">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'auth' -%}
        {%- if form.errors %}<div class="auth__msg is-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <label for="StorePassword">{{ 'password.label' | t }}</label>
        <input type="password" id="StorePassword" name="password" autocomplete="current-password" required>
        <button class="btn btn--bronze" type="submit">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Premium Natural Haircare" },
    { "type": "text", "id": "title", "label": "Headline", "default": "Opening" },
    { "type": "text", "id": "title_accent", "label": "Headline accent", "default": "soon." }
  ]
}
{% endschema %}
