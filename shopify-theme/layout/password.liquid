<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <title>{{ shop.name }}</title>
  {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% # theme-check-disable RemoteAsset %}
  {%- comment -%} The original Google Fonts (Cormorant Garamond + Montserrat) keep the typography identical. {%- endcomment %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  {% # theme-check-enable RemoteAsset %}
  {{ 'azula.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  {% render 'icon-sprite' %}
  <main id="main" role="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
