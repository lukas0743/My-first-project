<!doctype html>
<html class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif %}

  {%- assign tag_list = current_tags | join: ', ' %}
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.tagged' | t: tags: tag_list }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif %}
  {% render 'meta-tags' %}

  {% # theme-check-disable RemoteAsset %}
  {%- comment -%} The original Google Fonts (Cormorant Garamond + Montserrat) keep the typography identical. {%- endcomment %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  {% # theme-check-enable RemoteAsset %}

  {{ 'azula.css' | asset_url | stylesheet_tag }}
  {% style %}
    :root {
      --black: {{ settings.color_background }};
      --ivory: {{ settings.color_text }};
      --bronze: {{ settings.color_accent }};
      --bronze-light: {{ settings.color_accent_light }};
      --taupe: {{ settings.color_muted }};
      --forest: {{ settings.color_forest }};
      --bronze-gradient: linear-gradient(120deg, {{ settings.gradient_start }} 0%, {{ settings.gradient_middle }} 45%, {{ settings.gradient_end }} 100%);
    }
  {% endstyle %}

  <script>
    window.azula = {
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }}
      },
      cartType: {{ settings.cart_type | json }},
      strings: {
        added: {{ 'cart.added' | t | json }},
        error: {{ 'cart.error' | t | json }},
        openMenu: {{ 'header.open_menu' | t | json }},
        closeMenu: {{ 'header.close_menu' | t | json }},
        soldOut: {{ 'products.sold_out' | t | json }},
        unavailable: {{ 'products.unavailable' | t | json }},
        addToCart: {{ 'products.add_to_cart' | t | json }},
        cartOne: {{ 'cart.icon_label.one' | t: count: '__COUNT__' | json }},
        cartOther: {{ 'cart.icon_label.other' | t: count: '__COUNT__' | json }}
      }
    };
  </script>
  <script src="{{ 'azula.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }}">
  {% render 'icon-sprite' %}

  <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}
  {% render 'search-bar' %}

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>
